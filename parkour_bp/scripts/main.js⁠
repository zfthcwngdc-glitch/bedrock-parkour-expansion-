import { world, system } from "@minecraft/server";

// Listen for player chat or ticks to run parkour logic
world.beforeEvents.chatSend.subscribe((event) => {
    const player = event.sender;
    const message = event.message;

    if (message === "!parkour") {
        player.sendMessage("§aParkour Expansion active! Custom movement enabled.");
    }
});

// Main tick loop for movement tracking
system.runInterval(() => {
    for (const player of world.getAllPlayers()) {
        const viewDirection = player.getViewDirection();
        const velocity = player.getVelocity();

        // Add custom movement or sliding checks here
        // Example: Detect if player is falling or sprinting fast
        if (velocity.y < -0.5) {
            // Player is falling fast - ideal for slide/wall-run checks
        }
    }
}, 1);

